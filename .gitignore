# 曾导致本地设置备份被误提交（index48），故显式忽略。
*.bak-*
*.bak.*
.claude/.prompt-ring.json
.claude/settings.local.json
.claude/settings_rt.json
.claude/settings_ds.json
.claude/settings_k3.json
.claude/settings.permissions.json
benchmark/ci-*.log
benchmark/runs/
.claude/state/lifecycle.json
.claude/state/handoff.json
.claude/state/snapshots/precompact-*.json
improve_plan
.tooling/
apps
# 打包生成物（每次 build 重算，不入库）
packaging/template/
