# 摄影助手 v2 中转服务配置模板
# 用法：cp .env.example .env，然后把真实值填进 .env
# ⚠️ .env 已被 .gitignore 忽略，真实 Key 永远不要提交
#
# 本文件（.env.example）只含占位符，可以提交。

# DeepSeek 官方 API Key（必填；sk- 开头）
DEEPSEEK_API_KEY=

# 上游接口（一般不用改）
UPSTREAM=https://api.deepseek.com/chat/completions

# 模型名（和教练页直连默认一致）
MODEL=deepseek-v4-flash

# 监听端口（手机和电脑要在同一局域网才能互访）
PORT=8787

# 每个 IP 每分钟最多几次分析（省钱闸门）
RATE_LIMIT_PER_MIN=20

# 提示词文件路径（默认用包内 prompts/composition.md，一般不用改）
# PROMPT_FILE=./prompts/composition.md

# 允许客户端指定模型（1=允许，默认关闭——提示词和模型以服务端为准）
# ALLOW_CLIENT_MODEL=1
